{
  "_comment": "This is a template for local development overrides. Copy this file to local.json and customize your settings.",
  "_comment2": "local.json is gitignored and will override values from development.ejson.",
  "_comment3": "This file is for local development only and should NOT be committed.",

  "DATABASE": {
    "HOST": "localhost",
    "PORT": 5432,
    "USER": "myuser",
    "PASSWORD": "mypassword",
    "NAME": "mydb"
  },

  "REDIS": {
    "HOST": "localhost",
    "PORT": 6379,
    "PASSWORD": null
  },

  "MONITORING": {
    "LOG_LEVEL": "DEBUG",
    "DD_ENABLED": false
  },

  "SECURITY": {
    "JWT_SECRET_KEY": "local-development-secret-key-not-for-production",
    "RATE_LIMIT_ENABLED": false,
    "CORS_ORIGINS": ["http://localhost:3000", "http://localhost:3001"]
  },

  "DEBUG": true,
  "RELOAD": true
}
